# 你的照片与产物不进仓库

# 人像素材（个人隐私，绝不提交）
assets/persona/*.jpg
assets/persona/*.jpeg
assets/persona/*.png
assets/persona/alternates/*
!assets/persona/README.md
!assets/persona/face-card.md
!assets/persona/.gitkeep

# 生成产物（默认全部忽略）
*.png
*.jpg
*_thumb-220.jpg
spec-*.json

# 例外：模板、示例底图、示例 spec、README 用的效果图
!assets/**/*.png
!assets/**/*.jpg
!assets/spec-template*.json
!examples/bg-*.png
!examples/spec-*.json
!docs/preview/*.jpg

# 系统与缓存
.DS_Store
__pycache__/
*.pyc
.venv/
